<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat System"
        Height="640"
        Width="720">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Chat System"
            FontSize="28"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            Margin="0,0,0,25"/>

        <Grid Grid.Row="1">

            <!-- Sign In View -->
            
            <StackPanel
                x:Name="SignInView">

                <TextBlock
                    Text="User ID"
                    FontSize="16"
                    Margin="0,0,0,5"/>

                <TextBox
                    x:Name="UserIdTextBox"
                    Height="30"
                    FontSize="16"
                    Margin="0,0,0,15"/>

                <Button
                    x:Name="SignInButton"
                    Content="Sign In"
                    Width="120"
                    Height="35"
                    HorizontalAlignment="Center"
                    Click="SignInButton_Click"/>

                <TextBlock
                    x:Name="ErrorTextBlock"
                    Text=""
                    Foreground="Red"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Margin="0,15,0,0"/>


            </StackPanel>

            <!-- Channel List View -->
            
           
            <StackPanel
                x:Name="ChannelView"
                Visibility="Collapsed">

                <TextBlock
                    Text="Available Channels"
                    FontSize="20"
                    FontWeight="Bold"
                    Margin="0,0,0,10"/>

                <ListBox
                    x:Name="ChannelListBox"
                    Height="180"
                    Margin="0,0,0,15"/>

                <Button
                    Content="Join Channel"
                    Width="140"
                    Height="35"
                    HorizontalAlignment="Center"
                    Click="JoinChannelButton_Click"/>

                <Button
                    Content="Sign Out"
                    Width="140"
                    Height="35"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0"
                    Click="SignOutButton_Click"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>