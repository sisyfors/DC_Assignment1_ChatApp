<Window x:Class="ChatClient.PrivateWindow"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     Title="Private Chat"
     Height="500"
     Width="600"
     MinHeight="400"
     MinWidth="450">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- TITLE -->

        <TextBlock
        x:Name="PrivateTextBlock"
        Grid.Row="0"
        Text="Private Messages"
        FontSize="22"
        FontWeight="Bold"
        Margin="0,0,0,15"/>


        <!-- MESSAGES -->

        <ListBox
        x:Name="PrivateMessageListBox"
        Grid.Row="1"
        Margin="0,0,0,15"/>


        <!-- MESSAGE INPUT -->

        <Grid
        Grid.Row="2"
        Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox
            x:Name="PrivateMessageTextBox"
            Grid.Column="0"
            Height="35"
            VerticalContentAlignment="Center"
            Margin="0,0,10,0"/>

            <Button
            x:Name="SendButton"
            Grid.Column="1"
            Content="Send"
            Width="90"
            Height="35"
            IsDefault="True"
            Click="SendButton_Click"/>

        </Grid>


        <!-- CLOSE BUTTON -->

        <Button
        x:Name="CloseButton"
        Grid.Row="3"
        Content="Close Window"
        Width="120"
        Height="35"
        HorizontalAlignment="Center"
        Click="CloseButton_Click"/>

    </Grid>

</Window>
