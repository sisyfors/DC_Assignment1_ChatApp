<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="DuplexClient.MainWindow"
        Title="Chat System"
        Height="680"
        Width="720">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Chat System"
            FontSize="28"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            Margin="0,0,0,25"/>

        <Grid Grid.Row="1">

            <!-- Sign in block -->

            <StackPanel
                x:Name="SignInView">

                <TextBlock
                    Text="User ID"
                    FontSize="16"
                    Margin="0,0,0,5"/>

                <TextBox
                    x:Name="UserIdTextBox"
                    Height="30"
                    FontSize="16"
                    Margin="0,0,0,15"/>

                <Button
                    x:Name="SignInButton"
                    Content="Sign In"
                    Width="120"
                    Height="35"
                    HorizontalAlignment="Center"
                    Click="SignInButton_Click"/>

                <TextBlock
                    x:Name="ErrorTextBlock"
                    Text=""
                    Foreground="Red"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Margin="0,15,0,0"/>


            </StackPanel>

            <!-- Channel list view block -->

            <StackPanel
                x:Name="ChannelView"
                Visibility="Collapsed">

                <TextBlock
                    Text="Available Channels"
                    FontSize="20"
                    FontWeight="Bold"
                    Margin="0,0,0,10"/>

                <ListBox
                    x:Name="ChannelListBox"
                    Height="180"
                    Margin="0,0,0,15"/>

                <Button
                    Content="Join Channel"
                    Width="140"
                    Height="35"
                    HorizontalAlignment="Center"
                    Click="JoinChannelButton_Click"/>

                <TextBlock
                    Text="Create Channel"
                    FontSize="18"
                    FontWeight="Bold"
                    Margin="0,0,0,8"/>

                <TextBox
                    x:Name="NewChannelTextBox"
                    Height="30"
                    Margin="0,0,0,10"/>

                <Button
                    Content="Create Channel"
                    Width="140"
                    Height="35"
                    HorizontalAlignment="Center"
                    Click="CreateChannelButton_Click"/>

                <TextBlock
                    x:Name="ChannelErrorTextBlock"
                    Foreground="Red"
                    TextAlignment="Center"
                    Margin="0,10,0,0"/>

                <Button
                    Content="Sign Out"
                    Width="140"
                    Height="35"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0"
                    Click="SignOutButton_Click"/>

            </StackPanel>


            <!-- chat view block-->
            <Grid
                x:Name="ChatView" Visibility="Collapsed">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <TextBlock
                    x:Name="CurrentChannelTextBlock"
                    Grid.Row="0"
                    Text="Channel"
                    FontSize="20"
                    FontWeight="Bold"
                    Margin="0,0,0,10"/>


                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <ListBox
                        x:Name="MessageListBox"
                        Grid.Column="0"
                        Margin="0,0,10,0"/>

                    <StackPanel
                        Grid.Column="1">

                        <TextBlock
                            Text="Members"
                            FontWeight="Bold"
                            Margin="0,0,0,5"/>

                        <ListBox
                            x:Name="MemberListBox"
                            Height="207"
                            MouseDoubleClick="MemberListBox_MouseDoubleClick"/>
                        <TextBlock
                            Text="Files"
                            FontWeight="Bold" Margin="0,5,0,0"
                            />

                        <ListBox x:Name="FilesListBox" Height="109"
                                 Margin="0,5,0,0"/>

                    </StackPanel>

                </Grid>

                <Grid
                    Grid.Row="2"
                    Margin="0,15,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="MessageTextBox"
                        Grid.Column="0"
                        Height="35"
                        Margin="0,0,10,0"/>

                    <Button
                        Grid.Column="1"
                        Content="Send"
                        Width="90"
                        Height="35"
                        Click="SendMessageButton_Click"/>

                </Grid>

                <StackPanel
                    Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0">

                    <Button
                        Content="Leave Channel"
                        Width="120"
                        Height="35"
                        Click="LeaveChannelButton_Click"/>

                    <Button
                        Content="Sign Out"
                        Width="120"
                        Height="35"
                        Margin="10,0,0,0"
                        Click="SignOutButton_Click"/>

                </StackPanel>

                <StackPanel Grid.Row="3" Margin="570,0,0,-17">
                    <Button x:Name="UploadButton" Content="Upload" Height="27" Width="91" Click="UploadButton_Click" Margin="0,13,0,0"/>
                    <Button x:Name="DownloadButton" Content="Download" Height="27" Width="91" Click="DownloadButton_Click" Margin="0,5,0,0"/>
                </StackPanel>

            </Grid>

        </Grid>

    </Grid>

</Window>